# Copy to .env.local for local development. Never commit real secrets.
APPLICATION_URL=http://localhost:3000
# Local-only persistence. This SQLite adapter is not intended for production.
DATABASE_PATH=.data/downly.sqlite
SESSION_COOKIE_SECURE=false
# Set true only behind a trusted ingress that overwrites X-Real-IP.
TRUST_PROXY_HEADERS=false
# Comma-separated exact hostnames for future reviewed provider adapters. Empty by default.
SUPPORTED_PROVIDER_HOSTS=
# Not yet integrated: production PostgreSQL, Redis/BullMQ, S3-compatible private storage,
# transactional email, payment provider, and observability credentials.
